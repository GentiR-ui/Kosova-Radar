# Copy the keys you need into your environment / user-secrets. Never commit real values.
# Development and Testing defaults live in src/App.Api/appsettings.{Development,Testing}.json.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=app;Username=app;Password=app

# First Admin, created only when no user exists (REQ-P01). Production: set a strong, unique password,
# then remove these after the first start.
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=

# Failed logins per client IP and minute across all emails (ADR-019).
Login__MaxFailuresPerIpPerMinute=30
# Public API rate limit per client IP and minute (0 = off).
RateLimit__PublicPerMinute=300
# Reverse proxy IPs whose X-Forwarded-For/Proto headers are trusted (comma-separated).
Proxy__KnownProxies=
# ...or CIDR ranges, e.g. the Docker network of the proxy: 172.18.0.0/16
Proxy__KnownNetworks=

# Fixture sources carry synthetic data; keep this false in Production (true in Development/Testing).
Ingestion__AllowFixtureSources=false
Ingestion__SchedulerTickSeconds=60
Ingestion__HttpRetries=2
Ingestion__HttpTimeoutSeconds=20
# Minimum seconds between two requests to the same host (robots.txt fetches included)
Ingestion__PerHostDelaySeconds=10
# Events of HTML and auto-publish sources starting on a local date more than this many days after the fetch date are
# skipped and taken by a later fetch (replaces Ingestion__HtmlHorizonDays)
Ingestion__EventHorizonDays=3
# Auto-publish sources publish a daily deal only with at least this discount in percent
AutoPublish__MinDealDiscountPercent=35
# Items one run may publish automatically; the rest stays pending for a person
AutoPublish__MaxPerRun=100
# Creates the two HTML sources (Prishtina.com, Ka' Po Dalim) at start-up when missing
Seed__KnownSources=true
# Values for the sources created by that seeding (existing sources are never changed); an Admin can change them later
Seed__KnownSourcesActive=false
Seed__KnownSourcesAutoPublish=false
# Creates the inactive synthetic fixture source and fetches it once (Development only; never in Production)
Seed__SyntheticFixtures=false
# AI extraction (None, Fake, Gemini or Anthropic; empty = Gemini when Ai__ApiKey is set, else None). Fake is for Development/Testing only.
# Provider=Gemini or Anthropic without Ai__ApiKey stops startup. The key is a secret: environment only, never commit it.
Ai__Provider=
Ai__ApiKey=
# Empty = the provider default (gemini-3.5-flash-lite, or claude-haiku-4-5-20251001 for Anthropic)
Ai__Model=
# Minimum milliseconds between two AI calls in this process; about 4000 on the Gemini free tier, 0 = no spacing
Ai__MinIntervalMs=0
# AI calls per UTC day; further candidates get the issue AiUnavailable
Ai__DailyCallLimit=500
# Seconds one AI call may take (the Ai__MinIntervalMs wait counts against it)
Ai__TimeoutSeconds=15
# Public base URL of the site, shown in the crawler User-Agent (KosovaRadarBot/1.0 (+URL/bot))
Site__BaseUrl=https://example.com

# Test hooks (X-Test-Now, /api/_test/throw). Development/Testing only; startup fails elsewhere.
TestHooks__Enabled=false

# docker-compose.prod.yml reads these (copy to .env.prod, never commit it; see docs/RUNBOOK.md)
POSTGRES_PASSWORD=
SITE_BASE_URL=https://example.com
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PROXY_KNOWN_PROXIES=
PROXY_KNOWN_NETWORKS=
AI_PROVIDER=
AI_API_KEY=
# Empty = provider default model
AI_MODEL=
# About 4000 on the Gemini free tier (must stay below Ai__TimeoutSeconds * 1000)
AI_MIN_INTERVAL_MS=0
